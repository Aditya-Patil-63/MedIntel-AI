# ============================================
# MedIntel AI — .gitignore
# ============================================

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ----- Environment variables / secrets -----
.env
.env.*
!.env.example

# ----- ML artifacts -----
*.joblib
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.tflite
ml/models/saved/

# ----- Datasets (external only - NEVER commit to Git repository) -----
*.csv
*.tsv
*.arff
*.data
*.names
*.parquet
*.feather
*.xlsx
*.xls
ml/data/raw/
ml/data/processed/
data/raw/
data/processed/
datasets/
raw_data/
processed_data/

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Flutter -----
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.metadata
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log

# ----- Temporary files -----
*.tmp
*.temp

# ----- Generated reports -----
reports/generated_summaries/

# ----- OCR / Handwriting temp -----
ocr/temp/
handwriting/temp/

# ----- Database files -----
*.db
*.sqlite3
!database/schema/*.sql