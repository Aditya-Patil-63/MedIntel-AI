# ==============================================================================
# MedIntel AI Backend — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development and fill in the values.
# NEVER commit .env to version control. Keep all production credentials secret.
# ==============================================================================

# ----- Application & Runtime -----
APP_NAME=MedIntel AI
APP_ENV=development
# In production, DEBUG defaults to false if unset. Set true only for local debugging.
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ----- Database -----
# Local development default (SQLite):
DATABASE_URL=sqlite:///./medintel.db
# Production PostgreSQL (e.g., Neon Postgres with SSL mode):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# ----- Auth & Security -----
# JWT token signing secret.
# In production (APP_ENV=production), must be at least 32 characters and distinct from default.
SECRET_KEY=medintel-ai-secure-jwt-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Google OAuth client ID for token verification
# GOOGLE_CLIENT_ID=

# ----- CORS -----
# Comma-separated list of allowed origins (e.g. https://my-app.vercel.app,http://localhost:3000).
# If empty, permits all origins with allow_credentials=False for bearer token safety.
CORS_ORIGINS=

# ----- Generative AI & Explanations -----
# Provider: 'gemini' (live API) or 'mock' (deterministic fallback for testing/offline dev)
GENAI_PROVIDER=mock
# Required if GENAI_PROVIDER=gemini (falls back to mock if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048

# ----- OCR Engine -----
# Default OCR engine to resolve for image / scanned document processing ('tesseract' or 'easyocr')
DEFAULT_OCR_ENGINE=tesseract

# ----- Machine Learning Models -----
# Path to directory containing diabetes, heart_disease, and kidney_disease model bundles.
# Default resolves to repo-relative 'deploy/ml_models'.
MEDINTEL_ML_MODELS_DIR=deploy/ml_models
