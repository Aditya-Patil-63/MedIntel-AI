# ============================================
# MedIntel AI Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================

# ----- Application -----
APP_NAME=MedIntel AI
APP_ENV=development
DEBUG=true

# ----- Database -----
# SQLite database path (relative to backend/ directory)
DATABASE_URL=sqlite:///./medintel.db

# ----- Server -----
HOST=127.0.0.1
PORT=8000

# ----- Claude API (Phase 7 — NOT USED YET) -----
# CLAUDE_API_KEY=your-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ----- Machine Learning Models (Phase 7) -----
MEDINTEL_ML_MODELS_DIR=D:\MedIntel-Datasets\ml_models

# ----- Future Configuration -----
# These will be configured in later phases:
# OCR_ENGINE=easyocr
# MAX_UPLOAD_SIZE_MB=10
